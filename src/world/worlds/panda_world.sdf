<?xml version="1.0" ?>
<sdf version="1.11">
  <world name="panda_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate> 
    </physics>
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics">
      <!-- dartsim (the default engine) doesn't implement mimic joint
           constraints (see gz-sim Physics.cc "does not support mimic
           constraints"), which the Robotiq 2F-85's passive follower
           joints rely on to stay synced with the actuated knuckle.
           bullet-featherstone does support them. -->
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands">
    </plugin>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster">
    </plugin>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">

      <plugin filename="GzScene3D" name="3D View">
        <ignition-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </ignition-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.8 0.8 0.8</background_color>
        <camera_pose>4 4 3 0 0.5 -2.5</camera_pose>
      </plugin>

      <plugin filename="WorldControl" name="World control">
        <ignition-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <!-- The arm has no active ros2_control controller until
             world.launch.py's controller-spawner stage runs; unpaused
             physics before then lets it sag under gravity into an
             arbitrary configuration (and, combined with the cube
             DetachableJoints above, drag every cube along with it).
             world.launch.py unpauses explicitly via the world's /control
             service once the controllers are actually active. -->
        <start_paused>true</start_paused>
      </plugin>

      <plugin filename="WorldStats" name="World stats">
        <ignition-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </ignition-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>

      <plugin filename="JointPositionController" name="JointPositionController">
        <ignition-gui>
          <property type="double" key="height">600</property>
          <property type="double" key="width">400</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="top" target="top"/>
          </anchors>
        </ignition-gui>
        <model_name>panda</model_name>
      </plugin>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.5 1</diffuse>
      <specular>0.0 0.0 0.0 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0.5 -0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.55 1</ambient>
            <diffuse>0.6 0.6 0.55 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Both arms are rotated INWARD, mirrored, so they angle toward each
         other instead of both facing the same +X direction. 0.6m Y-gap
         was tried first and confirmed live to be too tight (bodies nearly
         touching at rest); 1.0m clears both arms' bases with real margin.

         Rotating only panda2 (a single -90deg turn to face panda) was
         tried first and confirmed live, three times over, to still leave
         a real lateral offset for whatever shared point the mobile robot
         hands cubes off at. Rotating BOTH arms 45deg (mirrored) was tried
         next, aimed so a shared point sits exactly on their perpendicular
         bisector (y=0.5), a genuinely zero-lateral, straight-ahead reach
         for both simultaneously. That fixed the earlier symptom (every
         attempt before it failed the SAME way regardless of the shared
         point's exact position), but retreat (lifting straight up right
         after grasping, object now rigidly attached) STILL failed at 45deg,
         at the identical height every time ("Unable to sample any valid
         states for goal tree"), with the identical descend-and-grasp at
         that same XY always succeeding. That position-independence is
         what actually rules out lateral offset as the cause: it's the
         VERTICAL lift combined with the forward reach the 45deg crossing
         point needs (0.707m, ~83% of nominal), asking for more total reach
         than available. 50deg pulls the crossing point in to ~0.65m
         forward reach (~76%, matching the original single-arm system's
         own proven margin) while still keeping real Nav2 clearance. See
         actuator_node.py's _retreat for the matching (smaller) lift-height
         change, since both were needed together, not either alone.
         See spatial_placement.py's WORKSPACE_BOUNDS and
         attach_detach_node.py's PICKUP_POINT_X/Y for the exact numbers.
         See actuator_node.py's BASE_YAW/_world_to_base for the matching
         frame-conversion this requires for BOTH arms now (arm 1 is no
         longer the simple, unrotated reference), and
         moveit2.launch.py's world->panda_link0 transform and
         panda2_mount_joint, which must carry the matching rotations for
         the combined planning scene (ik_feasibility_service.py's one
         consumer) to agree with this. -->
    <include>
      <name>panda</name>
      <uri>model://panda</uri>
      <pose>0.2 0 0 0 0 0.8726646</pose>
    </include>

    <include>
      <name>panda2</name>
      <uri>model://panda2</uri>
      <pose>0.2 1.0 0 0 0 -0.8726646</pose>
    </include>

    <model name="red_cube">
      <pose>3 3 0.03 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <!-- Solid cuboid: I = m(a^2+b^2)/12 = m*s^2/6
               = 0.1 * 0.06^2 / 6 = 6e-5 on each axis.
               This was 1e-5 (6x too low). Under-declared inertia on a body
               that gets rigidly constrained (the DetachableJoint grasp) and
               then swung through a retreat is a classic dartsim instability
               trigger: it makes the body far too easy to spin up under
               contact torque, and the solver can diverge. Observed as a
               single 13cm retreat hop taking 185s of wall clock and leaving
               panda_joint1/2/7 tens of radians outside their limits, after
               which MoveIt rejected every subsequent request with
               "CheckStartStateBounds: Start state out of bounds". -->
          <inertia>
            <ixx>0.00006</ixx>
            <iyy>0.00006</iyy>
            <izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- Grasp-stabilization workaround: bullet-featherstone's pinch-grasp
           contact solving isn't stable for a rigid body this small (cube
           slips/rotates out mid-lift regardless of friction/inertia/effort
           tuning), so actuator_node.py rigidly pins this cube to the
           gripper via this joint the instant it detects a successful
           grasp, instead of relying on contact friction to hold it through
           the lift/transport/retreat sequence. Starts already attached (gz
           has no "start detached" option for this system); actuator_node
           force-releases every cube over these topics at startup. -->
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda</child_model>
        <child_link>robotiq_85_base_link</child_link>
        <attach_topic>/model/red_cube/detachable_joint/attach</attach_topic>
        <detach_topic>/model/red_cube/detachable_joint/detach</detach_topic>
        <output_topic>/model/red_cube/detachable_joint/state</output_topic>
      </plugin>
      <!-- Second arm's grasp joint for this cube: either arm can pick it
           up, distinct topics from the first arm's plugin above so the two
           don't share attach/detach state. -->
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda2</child_model>
        <child_link>robotiq2_85_base_link</child_link>
        <attach_topic>/model/red_cube/detachable_joint2/attach</attach_topic>
        <detach_topic>/model/red_cube/detachable_joint2/detach</detach_topic>
        <output_topic>/model/red_cube/detachable_joint2/state</output_topic>
      </plugin>
    </model>

    <model name="blue_cube">
      <pose>-3 3 0.03 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <!-- Solid cuboid: I = m(a^2+b^2)/12 = m*s^2/6
               = 0.1 * 0.06^2 / 6 = 6e-5 on each axis.
               This was 1e-5 (6x too low). Under-declared inertia on a body
               that gets rigidly constrained (the DetachableJoint grasp) and
               then swung through a retreat is a classic dartsim instability
               trigger: it makes the body far too easy to spin up under
               contact torque, and the solver can diverge. Observed as a
               single 13cm retreat hop taking 185s of wall clock and leaving
               panda_joint1/2/7 tens of radians outside their limits, after
               which MoveIt rejected every subsequent request with
               "CheckStartStateBounds: Start state out of bounds". -->
          <inertia>
            <ixx>0.00006</ixx>
            <iyy>0.00006</iyy>
            <izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda</child_model>
        <child_link>robotiq_85_base_link</child_link>
        <attach_topic>/model/blue_cube/detachable_joint/attach</attach_topic>
        <detach_topic>/model/blue_cube/detachable_joint/detach</detach_topic>
        <output_topic>/model/blue_cube/detachable_joint/state</output_topic>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda2</child_model>
        <child_link>robotiq2_85_base_link</child_link>
        <attach_topic>/model/blue_cube/detachable_joint2/attach</attach_topic>
        <detach_topic>/model/blue_cube/detachable_joint2/detach</detach_topic>
        <output_topic>/model/blue_cube/detachable_joint2/state</output_topic>
      </plugin>
    </model>

    <model name="green_cube">
      <pose>3 -3 0.03 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.1</mass>
          <!-- Solid cuboid: I = m(a^2+b^2)/12 = m*s^2/6
               = 0.1 * 0.06^2 / 6 = 6e-5 on each axis.
               This was 1e-5 (6x too low). Under-declared inertia on a body
               that gets rigidly constrained (the DetachableJoint grasp) and
               then swung through a retreat is a classic dartsim instability
               trigger: it makes the body far too easy to spin up under
               contact torque, and the solver can diverge. Observed as a
               single 13cm retreat hop taking 185s of wall clock and leaving
               panda_joint1/2/7 tens of radians outside their limits, after
               which MoveIt rejected every subsequent request with
               "CheckStartStateBounds: Start state out of bounds". -->
          <inertia>
            <ixx>0.00006</ixx>
            <iyy>0.00006</iyy>
            <izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.06 0.06 0.06</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda</child_model>
        <child_link>robotiq_85_base_link</child_link>
        <attach_topic>/model/green_cube/detachable_joint/attach</attach_topic>
        <detach_topic>/model/green_cube/detachable_joint/detach</detach_topic>
        <output_topic>/model/green_cube/detachable_joint/state</output_topic>
      </plugin>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link</parent_link>
        <child_model>panda2</child_model>
        <child_link>robotiq2_85_base_link</child_link>
        <attach_topic>/model/green_cube/detachable_joint2/attach</attach_topic>
        <detach_topic>/model/green_cube/detachable_joint2/detach</detach_topic>
        <output_topic>/model/green_cube/detachable_joint2/state</output_topic>
      </plugin>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.80 1</ambient>
            <diffuse>0.85 0.83 0.80 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.85 0.83 0.80 1</ambient>
            <diffuse>0.85 0.83 0.80 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 8 2.5</size></box></geometry>
          <material>
