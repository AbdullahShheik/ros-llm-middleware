<?xml version="1.0" encoding="utf-8"?>
<robot name="panda">

  <!-- Panda arm group.
       tip_link is robotiq_85_base_link, NOT panda_link8: the two robot
       descriptions disagree about where panda_link8 is (the URDF puts it at
       the flange, coincident with panda_hand; model.sdf puts it 0.103m
       beyond panda_hand), so it does not name the same physical point in
       both and must not be used as a planning target. robotiq_85_base_link
       does, now that panda_gz.urdf.xacro anchors the Robotiq to panda_hand.
       kinematics.yaml declares no explicit tip for panda_arm, so the KDL
       solver takes its tip from here. Keeping this in sync with
       actuator_node.py's EEF_LINK is what guarantees the goal constraint and
       the IK tip are the same link. The group's DOF is unchanged; every
       joint between panda_link8 and robotiq_85_base_link is fixed. -->
  <group name="panda_arm">
    <chain base_link="panda_link0" tip_link="robotiq_85_base_link"/>
  </group>

  <group_state group="panda_arm" name="ready">
    <joint name="panda_joint1" value="0"/>
    <joint name="panda_joint2" value="-0.785"/>
    <joint name="panda_joint3" value="0"/>
    <joint name="panda_joint4" value="-2.356"/>
    <joint name="panda_joint5" value="0"/>
    <joint name="panda_joint6" value="1.571"/>
    <joint name="panda_joint7" value="0.785"/>
  </group_state>
  <group_state group="panda_arm" name="extended">
    <joint name="panda_joint1" value="0"/>
    <joint name="panda_joint2" value="0"/>
    <joint name="panda_joint3" value="0"/>
    <joint name="panda_joint4" value="0"/>
    <joint name="panda_joint5" value="0"/>
    <joint name="panda_joint6" value="1.571"/>
    <joint name="panda_joint7" value="0.785"/>
  </group_state>
  <group_state group="panda_arm" name="transport">
    <joint name="panda_joint1" value="0"/>
    <joint name="panda_joint2" value="-0.5599"/>
    <joint name="panda_joint3" value="0"/>
    <joint name="panda_joint4" value="-2.97"/>
    <joint name="panda_joint5" value="0"/>
    <joint name="panda_joint6" value="0"/>
    <joint name="panda_joint7" value="0.785"/>
  </group_state>

  <!-- Robotiq 2F-85 hand group -->
  <!-- Only the left knuckle joint is actuated; all others are mimic -->
  <!-- 0.0 = fully open, 0.8 = fully closed -->
  <group name="hand">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>

  <group_state group="hand" name="open">
    <joint name="robotiq_85_left_knuckle_joint" value="0.0"/>
  </group_state>
  <group_state group="hand" name="close">
    <joint name="robotiq_85_left_knuckle_joint" value="0.8"/>
  </group_state>

  <!-- parent_link tracks panda_arm's tip_link (see above); panda_link8 does
       not name the same point in the URDF and the SDF. -->
  <end_effector name="hand" parent_link="robotiq_85_base_link" group="hand" parent_group="panda_arm"/>

  <virtual_joint name="virtual_joint" type="floating" parent_frame="world" child_link="panda_link0"/>

  <!-- Arm self-collision disables (unchanged from upstream) -->
  <disable_collisions link1="panda_link0" link2="panda_link1" reason="Adjacent"/>
  <disable_collisions link1="panda_link0" link2="panda_link2" reason="Never"/>
  <disable_collisions link1="panda_link0" link2="panda_link3" reason="Never"/>
  <disable_collisions link1="panda_link0" link2="panda_link4" reason="Never"/>
  <disable_collisions link1="panda_link1" link2="panda_link2" reason="Adjacent"/>
  <disable_collisions link1="panda_link1" link2="panda_link3" reason="Never"/>
  <disable_collisions link1="panda_link1" link2="panda_link4" reason="Never"/>
  <disable_collisions link1="panda_link2" link2="panda_link3" reason="Adjacent"/>
  <disable_collisions link1="panda_link2" link2="panda_link4" reason="Never"/>
  <disable_collisions link1="panda_link2" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="panda_link3" link2="panda_link4" reason="Adjacent"/>
  <disable_collisions link1="panda_link3" link2="panda_link5" reason="Never"/>
  <disable_collisions link1="panda_link3" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="panda_link3" link2="panda_link7" reason="Never"/>
  <disable_collisions link1="panda_link4" link2="panda_link5" reason="Adjacent"/>
  <disable_collisions link1="panda_link4" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="panda_link4" link2="panda_link7" reason="Never"/>
  <disable_collisions link1="panda_link5" link2="panda_link6" reason="Adjacent"/>
  <disable_collisions link1="panda_link6" link2="panda_link7" reason="Adjacent"/>

  <!-- Robotiq gripper self-collision disables -->
  <disable_collisions link1="robotiq_85_base_link" link2="panda_link7" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent"/>
  <!-- The two halves of each side's four-bar linkage: the finger link and the
       inner knuckle run alongside each other and touch at some apertures, but
       they are driven by the same mimic chain and cannot actually collide.
       Missing here, this aborted every plan issued while the gripper was
       closed with "CheckStartStateCollision ... 1 contact(s) detected :
       robotiq_85_right_finger_link / robotiq_85_right_inner_knuckle_link",
       intermittently, because the software mimic bridge
       (action_dispatcher/gripper_mimic_bridge.py) lets the two sides' angles
       differ slightly, so whether the meshes touch varies run to run. -->
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent"/>

  <!-- Franka finger links are still present in the base URDF xacro but
       replaced by Robotiq in simulation. Disable all their collisions
       so MoveIt does not abort planning due to finger self-collision. -->
  <disable_collisions link1="panda_hand" link2="panda_leftfinger" reason="Adjacent"/>
  <disable_collisions link1="panda_hand" link2="panda_rightfinger" reason="Adjacent"/>
  <disable_collisions link1="panda_leftfinger" link2="panda_rightfinger" reason="Default"/>
  <disable_collisions link1="panda_hand" link2="panda_link7" reason="Adjacent"/>
  <disable_collisions link1="panda_leftfinger" link2="panda_link7" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="panda_link7" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="panda_link6" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="panda_link3" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="panda_link3" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="panda_link4" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="panda_link4" reason="Never"/>
  <!-- panda_hand overlaps with Robotiq base since Robotiq attaches to panda_link8
       which sits inside panda_hand. Disable all panda_hand/finger <-> Robotiq pairs. -->
  <disable_collisions link1="panda_hand" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="panda_hand" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <!-- The pairs above missed the links that actually move inward when the
       gripper closes (knuckle/finger/finger_tip). The frozen Franka finger
       meshes sit right where those Robotiq links travel through when
       closing on an object, so every plan requested after a grasp got
       rejected by CheckStartStateCollision ("2 contact(s) detected:
       panda_leftfinger - robotiq_85_left_finger_tip_link, ..."), even
       though the grasp itself succeeded; the arm just could never move
       again afterward, which looked like "picks up but never lifts". -->
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="panda_leftfinger" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="panda_rightfinger" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <passive_joint name="panda_finger_joint1"/>
  <passive_joint name="panda_finger_joint2"/>
</robot>