        <!-- Robotiq 2F-85 Gripper Joints -->
        <joint name="robotiq_85_base_joint" type="fixed">
            <pose relative_to="panda_link8">0 0 0 0 0 0</pose>
            <parent>panda_link8</parent>
            <child>robotiq_85_base_link</child>
        </joint>

        <joint name="robotiq_85_left_knuckle_joint" type="revolute">
            <pose relative_to="robotiq_85_base_link">0.03060114 0.0 0.05490452 0 0 0</pose>
            <parent>robotiq_85_base_link</parent>
            <child>robotiq_85_left_knuckle_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>0.0</lower><upper>0.8</upper><effort>50</effort><velocity>0.5</velocity></limit>
            </axis>
        </joint>

        <joint name="robotiq_85_right_knuckle_joint" type="revolute">
            <pose relative_to="robotiq_85_base_link">-0.03060114 0.0 0.05490452 0 0 0</pose>
            <parent>robotiq_85_base_link</parent>
            <child>robotiq_85_right_knuckle_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>-0.8</lower><upper>0.0</upper><effort>50</effort><velocity>0.5</velocity></limit>
                <mimic joint="robotiq_85_left_knuckle_joint">
                    <multiplier>-1</multiplier>
                    <offset>0</offset>
                    <reference>0</reference>
                </mimic>
            </axis>
        </joint>

        <joint name="robotiq_85_left_finger_joint" type="fixed">
            <pose relative_to="robotiq_85_left_knuckle_link">0.03152616 0.0 -0.00376347 0 0 0</pose>
            <parent>robotiq_85_left_knuckle_link</parent>
            <child>robotiq_85_left_finger_link</child>
        </joint>

        <joint name="robotiq_85_right_finger_joint" type="fixed">
            <pose relative_to="robotiq_85_right_knuckle_link">-0.03152616 0.0 -0.00376347 0 0 0</pose>
            <parent>robotiq_85_right_knuckle_link</parent>
            <child>robotiq_85_right_finger_link</child>
        </joint>

        <joint name="robotiq_85_left_inner_knuckle_joint" type="revolute">
            <pose relative_to="robotiq_85_base_link">0.0127 0.0 0.06142 0 0 0</pose>
            <parent>robotiq_85_base_link</parent>
            <child>robotiq_85_left_inner_knuckle_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>0.0</lower><upper>0.8</upper><effort>50</effort><velocity>0.5</velocity></limit>
                <mimic joint="robotiq_85_left_knuckle_joint">
                    <multiplier>1</multiplier>
                    <offset>0</offset>
                    <reference>0</reference>
                </mimic>
            </axis>
        </joint>

        <joint name="robotiq_85_right_inner_knuckle_joint" type="revolute">
            <pose relative_to="robotiq_85_base_link">-0.0127 0.0 0.06142 0 0 0</pose>
            <parent>robotiq_85_base_link</parent>
            <child>robotiq_85_right_inner_knuckle_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>-0.8</lower><upper>0.0</upper><effort>50</effort><velocity>0.5</velocity></limit>
                <mimic joint="robotiq_85_left_knuckle_joint">
                    <multiplier>-1</multiplier>
                    <offset>0</offset>
                    <reference>0</reference>
                </mimic>
            </axis>
        </joint>

        <joint name="robotiq_85_left_finger_tip_joint" type="revolute">
            <pose relative_to="robotiq_85_left_finger_link">0.00563134 0.0 0.04718515 0 0 0</pose>
            <parent>robotiq_85_left_finger_link</parent>
            <child>robotiq_85_left_finger_tip_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>-0.8</lower><upper>0.0</upper><effort>50</effort><velocity>0.5</velocity></limit>
                <mimic joint="robotiq_85_left_knuckle_joint">
                    <multiplier>-1</multiplier>
                    <offset>0</offset>
                    <reference>0</reference>
                </mimic>
            </axis>
        </joint>

        <joint name="robotiq_85_right_finger_tip_joint" type="revolute">
            <pose relative_to="robotiq_85_right_finger_link">-0.00563134 0.0 0.04718515 0 0 0</pose>
            <parent>robotiq_85_right_finger_link</parent>
            <child>robotiq_85_right_finger_tip_link</child>
            <axis>
                <xyz>0 -1 0</xyz>
                <limit><lower>0.0</lower><upper>0.8</upper><effort>50</effort><velocity>0.5</velocity></limit>
                <mimic joint="robotiq_85_left_knuckle_joint">
                    <multiplier>1</multiplier>
                    <offset>0</offset>
                    <reference>0</reference>
                </mimic>
            </axis>
        </joint>
        <!-- End-effector -->
        <link name="panda_link8">
            <pose relative_to="end_effector_frame_fixed_joint">0 0 0 0 0 0</pose>
        </link>
        <joint name="end_effector_frame_fixed_joint" type="fixed">
            <pose relative_to="panda_hand">0 0 0.103 0 0 0</pose>
            <parent>panda_hand</parent>
            <child>panda_link8</child>
        </joint>
        <!-- ros2_control hardware interface: exposes each joint's position
             command/state interfaces to a real ros2_control controller_manager,
             which is what lets MoveIt2's FollowJointTrajectory execution
             actually drive this model (the previous per-joint
             ignition-gazebo-joint-position-controller-system plugins only
             accepted raw Gazebo-transport position commands with no ROS2
             action interface, so MoveIt had nothing to execute against). -->
        <ros2_control name="GazeboSimSystem" type="system">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
            <joint name="panda_joint1">
                <command_interface name="position">
                    <param name="min">-2.897246558310587</param>
                    <param name="max">2.897246558310587</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint2">
                <command_interface name="position">
                    <param name="min">-1.762782544514273</param>
                    <param name="max">1.762782544514273</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint3">
                <command_interface name="position">
                    <param name="min">-2.897246558310587</param>
                    <param name="max">2.897246558310587</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint4">
                <command_interface name="position">
                    <param name="min">-3.07177948351002</param>
                    <param name="max">-0.06981317007977318</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint5">
                <command_interface name="position">
                    <param name="min">-2.897246558310587</param>
                    <param name="max">2.897246558310587</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint6">
                <command_interface name="position">
                    <param name="min">-0.0174532925199433</param>
                    <param name="max">3.752457891787809</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
            <joint name="panda_joint7">
                <command_interface name="position">
                    <param name="min">-2.897246558310587</param>
                    <param name="max">2.897246558310587</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
            </joint>
        
            <!-- Robotiq 2F-85: single actuated joint + mimic joints. The
                 other 4 gripper joints are now real bullet-featherstone
                 mimic constraints (see panda_world.sdf's physics engine
                 selection), not free-floating -- driving this one joint
                 also has to move that whole coupled 5-joint linkage.
                 gz_ros2_control's default position_proportional_gain
                 (0.1, tuned for a single free joint) turned out to have
                 nowhere near enough authority for that: closing from
                 fully open barely moved the joint at all inside a 30s
                 wait, even completely unobstructed. -->
            <joint name="robotiq_85_left_knuckle_joint">
                <command_interface name="position">
                    <param name="position_proportional_gain">20</param>
                </command_interface>
                <state_interface name="position">
                    <param name="initial_value">0.0</param>
                </state_interface>
                <state_interface name="velocity"/>
            </joint>
        </ros2_control>

        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <!-- world/launch/world.launch.py rewrites this placeholder to the
                 real absolute path of panda_ros2_controllers.yaml at launch
                 time (SDF has no package-path substitution of its own). -->
            <parameters>__PANDA_ROS2_CONTROLLERS_YAML__</parameters>
        </plugin>
    </model>
</sdf>