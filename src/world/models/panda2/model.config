<?xml version='1.0'?>
<model>
    <name>Panda2</name>
    <version>1.0</version>
    <sdf version='1.7'>model.sdf</sdf>

    <description>
        Second Franka Emika Panda arm, placed side by side with the first
        ("panda") for dual-arm operation. All joint/link names are prefixed
        panda2_/robotiq2_85_ so the two instances never collide in Gazebo
        (which does not auto-namespace joint/link names per model instance).
        Mesh/material assets are NOT duplicated here -- every mesh <uri>
        below points back at model://panda/meshes/..., reusing the original
        model's (visually identical) geometry rather than doubling the
        ~75MB of binary assets in the repo.
    </description>
</model>
